        { "private"      , PRIVATE       , LANGUAGE_OO },
        { "protected"    , PROTECTED     , LANGUAGE_OO },

        { "new"          , NEW           , LANGUAGE_OO },

        // Qt
        { "signals"      , SIGNAL        , LANGUAGE_CXX },
