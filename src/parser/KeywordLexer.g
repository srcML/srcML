        { "VERBOSE",                                            VERBOSE_CMAKE, LANGUAGE_CMAKE },
        { "VERSION",                                            VERSION_CMAKE, LANGUAGE_CMAKE },
        { "VERSION_SCHEMA",                                     VERSION_SCHEMA_CMAKE, LANGUAGE_CMAKE },
        { "VIEW",                                               VIEW_CMAKE, LANGUAGE_CMAKE },
        { "WARNING",                                            WARNING_CMAKE, LANGUAGE_CMAKE },
        { "WILL_FAIL",                                          WILL_FAIL_CMAKE, LANGUAGE_CMAKE },
