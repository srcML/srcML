<switch>match <expr><name>a</name></expr> <block>{<block_content>
  <case><expr><name>_</name></expr> =&gt; <block type="pseudo"><block_content><expr_stmt><expr><tuple>()</tuple></expr></expr_stmt></block_content></block></case>
</block_content>}</block></switch>
</unit>

<unit revision="1.0.0" language="Rust">
