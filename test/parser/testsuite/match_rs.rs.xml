<unit revision="1.0.0" language="Rust">
<switch>match <expr><name>boolean</name></expr> <block>{<block_content>
  <case><expr><literal type="boolean">true</literal></expr> =&gt; <block type="pseudo"><block_content><expr_stmt><expr><literal type="number">1</literal></expr></expr_stmt></block_content></block></case>,
  <case><expr><literal type="boolean">false</literal></expr> =&gt; <block type="pseudo"><block_content><expr_stmt><expr><literal type="number">-1</literal></expr></expr_stmt></block_content></block></case>
</block_content>}</block></switch>
</unit>

<unit revision="1.0.0" language="Rust">
<switch>match <expr><name>a</name></expr> <block>{<block_content>
  <case><expr><decl><name>b</name></decl></expr> =&gt; <block type="pseudo"><block_content><expr_stmt><expr><tuple>()</tuple></expr></expr_stmt></block_content></block></case>
</block_content>}</block></switch>
</unit>

