<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<unit xmlns="http://www.srcML.org/srcML/src" revision="1.0.0" language="Rust" url="specifier_rs">

<!-- visibility -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub(self)</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub(super)</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub(crate)</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub(in <name>a</name>)</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>pub(in <name><name>a</name><operator>::</operator><name>b</name></name>)</specifier></expr>
</unit>

<!-- foreign function interface -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>extern</specifier></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>extern <literal type="string">"C"</literal></specifier></expr>
</unit>

<!-- memory safety -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>unsafe</specifier></expr>
</unit>

<!-- 'safe' is a qualifier, it is only a specifier in the context of item declarations in unsafe extern blocks -->
<unit revision="1.0.0" language="Rust">
<expr><name>safe</name></expr>
</unit>

<unit revision="1.0.0" language="Rust">
<block><specifier>unsafe</specifier> <specifier>extern <literal type="string">"C"</literal></specifier> {<block_content>
  <decl_stmt><decl type="static"><specifier>safe</specifier> static <name>A</name>: <type><name>i32</name></type></decl>;</decl_stmt>
  <function_decl><specifier>safe</specifier> fn <name>a</name><parameter_list>()</parameter_list>;</function_decl>
</block_content>}</block>
</unit>

<unit revision="1.0.0" language="Rust">
<expr><specifier>dyn</specifier></expr>
</unit>

<!-- asynchronous -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>async</specifier></expr>
</unit>

<!-- ownership -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>move</specifier></expr>
</unit>

<!-- constant -->

<unit revision="1.0.0" language="Rust">
<expr><specifier>const</specifier></expr>
</unit>

</unit>
